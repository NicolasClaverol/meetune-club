# Modèle des variables d'environnement : copier ce fichier en .env et remplir les valeurs.
# Ne jamais mettre de vraies valeurs ici : ce fichier est commité sur Git.
# Les URL se trouvent dans le tableau de bord Neon (ou Vercel > Storage).

# Connexion poolée (mutualisée), utilisée par le site
DATABASE_URL=

# Connexion directe, utilisée par les migrations Prisma (prisma.config.ts)
DATABASE_URL_UNPOOLED=
